# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Logs and local experiment outputs
*.log
logs/
outputs/
results/
runs/
checkpoints/
wandb/
tensorboard/
experiments/layerwise_probe/features/
# experiments/syntax_preservation: downloaded UD EWT files and extracted features stay local; result tables are tracked.
experiments/syntax_preservation/data/
experiments/syntax_preservation/features/
!experiments/syntax_preservation/results/
# Run folders: only the per-seed result tables are tracked; checkpoints and logs stay local.
!experiments/layerwise_probe/runs/
!experiments/layerwise_probe/runs_kl/
experiments/layerwise_probe/runs/*/*
experiments/layerwise_probe/runs_kl/*/*
!experiments/layerwise_probe/runs/*/tweeteval_results.json
!experiments/layerwise_probe/runs/*/tweeteval_results.csv
!experiments/layerwise_probe/runs_kl/*/tweeteval_results.json
!experiments/layerwise_probe/runs_kl/*/tweeteval_results.csv
# Small layerwise_probe result tables (CSV/NPZ/TXT, a few MB) are tracked.
!experiments/layerwise_probe/results/
# Published experiment summaries are intentionally tracked.
!experiments/
!experiments/sia_pic/
!experiments/sia_pic/results/
!experiments/sia_pic/results/*.json
!experiments/sia_pic/results/*.csv

# Model and optimizer artifacts
*.ckpt
*.pt
*.pth
*.safetensors

# Local environment and tooling files
.env
.env.*
.idea/
.vscode/
# H1 (experiments/coarse_to_fine): extracted features (3.5 GB) stay local; plan, notebook and results are tracked.
experiments/coarse_to_fine/features/
!experiments/coarse_to_fine/results/

# H6 (experiments/dimension_routing): track json metrics, summaries, and reports; model weights stay local.
!experiments/dimension_routing/outputs/
!experiments/dimension_routing/outputs/**
experiments/dimension_routing/outputs/**/*.pt

